# Banco de dados PostgreSQL. Em produção, use a connection string do Vercel Postgres
# (Storage > Create Database no dashboard da Vercel) ou de outro provedor (Neon, Supabase etc).
DATABASE_URL="postgresql://user:password@localhost:5432/mydb?schema=public"

# Chave usada pelo Auth.js para assinar sessões. Gere a sua com:
#   npx auth secret
# ou
#   openssl rand -base64 32
AUTH_SECRET=""

# Usados apenas pelo script de seed (prisma/seed.ts) para criar a conta admin inicial.
# Troque a senha depois de rodar o seed pela primeira vez.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="changeme123"
ADMIN_NAME="Admin"

# Upload de imagens via Vercel Blob. Crie um Blob Store em Storage > Create Database
# no dashboard da Vercel (ou rode `vercel env pull` após conectar o projeto) e cole o token aqui.
BLOB_READ_WRITE_TOKEN=""
